{
	"name": "donatj/alike-color-finder",
	"license": "MIT",
	"require": {
		"donatj/flags": "^1.6",
		"php": ">=7.4"
	},
	"require-dev": {
		"corpus/coding-standard": "^0.9.0",
		"donatj/drop": "^1.1",
		"friendsofphp/php-cs-fixer": "^3.95",
		"php-parallel-lint/php-parallel-lint": "^1.4",
		"phpstan/phpstan": "^2.2",
		"phpunit/phpunit": "^8.5 || ^9.6 || ^10.5",
		"squizlabs/php_codesniffer": "^3.6"
	},
	"authors": [
		{
			"name": "Jesse Donat",
			"email": "donatj@gmail.com"
		}
	],
	"autoload": {
		"psr-4": {
			"donatj\\AlikeColorFinder\\": "src/"
		}
	},
	"bin": [
		"composer/bin/alike"
	],
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	}
}
